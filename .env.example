# Copy this file to .env and fill in your values. NEVER commit .env.

# Gmail account used to SEND the report (App Password required — see README)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_APP_PASSWORD=your16charapppassword

# Where the daily report is delivered
REPORT_RECIPIENT=you@example.com

# Optional: comma-separated extra recipients
REPORT_CC=

# Independent cross-check data source (recommended).
# Get a FREE key at https://www.tiingo.com/ (Account -> API -> Token).
# When set, each fetch is validated: yfinance close vs Tiingo close within tolerance.
# Leave blank to run on yfinance alone + internal sanity checks.
TIINGO_API_KEY=
